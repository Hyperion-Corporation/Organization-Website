---
/**
 * ResearchOrbit — Astro island visualizing the Visual Graph Programming
 * product graph as orbiting domain nodes (docs-site companion to the main
 * site's ResearchConstellation).
 *
 * Styled with the Hyperion observatory palette (see
 * docs/website/src/css/observatory.css) and a transparent page background, so
 * the island reads as a native section of the host page rather than an
 * embedded document. The orbit ring rotates; the animation is dropped under
 * `prefers-reduced-motion: reduce`.
 */
interface Props {
  seed?: number;
  title?: string;
}

const { seed = 42, title = 'Research orbit' } = Astro.props;

function mulberry32(a: number) {
  return function next() {
    let t = (a += 0x6d2b79f5);
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rand = mulberry32(seed);
const labels = ['Research', 'Graph', 'Metrics', 'Assets', 'Storyboards', 'Simulation'];
const cx = 200;
const cy = 140;
const nodes = labels.map((label, i) => {
  const angle = (i / labels.length) * Math.PI * 2 - Math.PI / 2;
  const r = 74 + rand() * 16;
  return {
    label,
    x: cx + Math.cos(angle) * r,
    y: cy + Math.sin(angle) * r,
  };
});
const islandId = `ro-${seed}`;
---

<section class="research-orbit" id={islandId} aria-labelledby={`${islandId}-title`}>
  <header>
    <p class="kicker">Astro island · docs site</p>
    <h2 id={`${islandId}-title`}>{title}</h2>
    <p class="sub">Domain nodes in orbit around applied research (illustrative, static export).</p>
  </header>
  <svg viewBox="0 0 400 280" role="img" aria-label={title} class="orbit-svg">
    <defs>
      <radialGradient id={`${islandId}-core`} cx="50%" cy="50%">
        <stop offset="0%" stop-color="#67e8f9" stop-opacity="0.9" />
        <stop offset="100%" stop-color="#0ea5e9" stop-opacity="0.15" />
      </radialGradient>
      <linearGradient id={`${islandId}-spoke`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#22d3ee" />
        <stop offset="100%" stop-color="#a78bfa" />
      </linearGradient>
    </defs>

    <circle cx={cx} cy={cy} r="96" class="ring ring-outer" fill="none" />
    <circle cx={cx} cy={cy} r="72" class="ring" fill="none" />

    {nodes.map((n) => <line x1={cx} y1={cy} x2={n.x} y2={n.y} class="spoke" stroke={`url(#${islandId}-spoke)`} />)}

    <circle cx={cx} cy={cy} r="30" class="core-glow" fill={`url(#${islandId}-core)`} />
    <circle cx={cx} cy={cy} r="22" class="core" />
    <text x={cx} y={cy + 4} text-anchor="middle" class="core-label">VGP</text>

    {nodes.map((n) => (
      <g>
        <circle cx={n.x} cy={n.y} r="15" class="node" />
        <circle cx={n.x} cy={n.y} r="3" class="node-dot" />
        <text x={n.x} y={n.y + 28} text-anchor="middle" class="node-label">{n.label}</text>
      </g>
    ))}
  </svg>
  <p class="note">Built as a static Astro island for the Docusaurus docs dashboard (MFP5).</p>
</section>

<style>
  .research-orbit {
    color: #e2e8f0;
    font-family: 'Lexend', 'Inter', ui-sans-serif, system-ui, sans-serif;
  }
  .kicker {
    margin: 0 0 0.3rem;
    color: #94a3b8;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  header h2 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 750;
    letter-spacing: -0.02em;
  }
  .sub {
    margin: 0.35rem 0 0.85rem;
    color: #94a3b8;
    font-size: 0.85rem;
  }
  .orbit-svg {
    display: block;
    width: 100%;
    max-width: 34rem;
    height: auto;
    margin: 0 auto;
    border-radius: 12px;
    background: radial-gradient(circle at 50% 46%, rgba(56, 189, 248, 0.12), transparent 62%);
  }
  .ring {
    stroke: rgba(148, 163, 184, 0.3);
    stroke-dasharray: 4 8;
    transform-origin: 200px 140px;
    animation: orbit-spin 46s linear infinite;
  }
  .ring-outer {
    stroke: rgba(139, 92, 246, 0.28);
    animation-direction: reverse;
    animation-duration: 68s;
  }
  .spoke {
    stroke-width: 1.1;
    opacity: 0.45;
  }
  .core-glow {
    filter: blur(1px);
  }
  .core {
    fill: rgba(8, 20, 38, 0.85);
    stroke: #67e8f9;
    stroke-width: 1.6;
  }
  .core-label {
    fill: #e0f2fe;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
  }
  .node {
    fill: rgba(15, 23, 42, 0.8);
    stroke: #a78bfa;
    stroke-width: 1.4;
  }
  .node-dot {
    fill: #c4b5fd;
  }
  .node-label {
    fill: #cbd5e1;
    font-size: 9.5px;
    font-weight: 650;
  }
  .note {
    margin: 0.8rem 0 0;
    color: #94a3b8;
    font-size: 0.74rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .ring {
      animation: none;
    }
  }

  @keyframes orbit-spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
